{
  "name": "camofox-web-search-pi",
  "version": "0.0.5",
  "description": "Native Pi extension for camofox-web-search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idefav/web-search.git",
    "directory": "plugins/pi"
  },
  "homepage": "https://github.com/idefav/web-search#readme",
  "bugs": {
    "url": "https://github.com/idefav/web-search/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "camofox-web-search-client": "0.0.5",
    "@sinclair/typebox": "0.34.41"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
