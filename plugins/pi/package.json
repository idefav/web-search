{
  "name": "camofox-web-search-pi",
  "version": "0.1.0",
  "description": "Native Pi extension for camofox-web-search",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -b" },
  "dependencies": {
    "camofox-web-search-client": "0.1.0",
    "@sinclair/typebox": "0.34.41"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  }
}
