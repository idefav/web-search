{
  "name": "camofox-web-search-openclaw",
  "version": "0.0.4",
  "description": "Native OpenClaw web_search and web_fetch providers for Camofox Web Search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idefav/web-search.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://github.com/idefav/web-search#readme",
  "bugs": {
    "url": "https://github.com/idefav/web-search/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.7.1"
    }
  }
}
