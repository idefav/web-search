WEB_SEARCH_ENDPOINT=https://search.example.com
WEB_SEARCH_API_KEY=replace-with-the-public-gateway-key

# Deep Agents accepts LangChain model identifiers. Install the matching provider
# integration if you change provider.
DEEPAGENTS_MODEL=openai:gpt-5.5
OPENAI_API_KEY=replace-with-an-openai-api-key

# Custom OpenAI-compatible provider (vLLM, LocalAI, Together, or another
# compatible endpoint). Uncomment these values and replace DEEPAGENTS_MODEL
# above with the provider-native model name. For auth-free local servers, use
# any non-empty DEEPAGENTS_API_KEY value such as "local".
# DEEPAGENTS_MODEL=your-model-name
# DEEPAGENTS_MODEL_PROVIDER=openai
# DEEPAGENTS_BASE_URL=http://127.0.0.1:8000/v1
# DEEPAGENTS_API_KEY=local
# DEEPAGENTS_TIMEOUT_SECONDS=120
# DEEPAGENTS_MAX_RETRIES=6
