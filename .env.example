# Generate independent values, for example: openssl rand -hex 32
WEB_SEARCH_API_KEY=
CAMOFOX_ACCESS_KEY=
WEB_SEARCH_PORT=8080
# Published deployments set this to ghcr.io/<owner>/<repo>:latest
WEB_SEARCH_IMAGE=camofox-web-search:local
# Optional when using deploy/compose.public.yaml
WEB_SEARCH_DOMAIN=
