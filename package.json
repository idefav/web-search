{
  "name": "camofox-web-search-monorepo",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx apps/server/src/index.ts",
    "start": "node apps/server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "release:version": "node scripts/set-version.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "e2e:docker": "scripts/docker-e2e.sh"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "marked": "18.0.7",
    "vitest": "4.1.10"
  }
}
